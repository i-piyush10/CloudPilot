CLOUDPILOT_MODE=simulation
CLOUDPILOT_DATABASE=/data/cloudpilot.db
CLOUDPILOT_WORKLOAD_URL=http://workload:8001
CLOUDPILOT_PROMETHEUS_URL=http://prometheus:9090
CLOUDPILOT_MIN_REPLICAS=1
CLOUDPILOT_MAX_REPLICAS=8
CLOUDPILOT_CAPACITY_RPS_PER_POD=20
CLOUDPILOT_HEADROOM=1.25
CLOUDPILOT_FORECAST_HORIZON_SECONDS=60
CLOUDPILOT_CONTROL_INTERVAL_SECONDS=15
CLOUDPILOT_SCALE_COOLDOWN_SECONDS=45
CLOUDPILOT_NAMESPACE=cloudpilot
CLOUDPILOT_DEPLOYMENT=cloudpilot-workload
CLOUDPILOT_LABEL_SELECTOR=app=cloudpilot-workload
CLOUDPILOT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

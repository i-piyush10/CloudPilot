{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat", "title": "Current replicas", "id": 1,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "cloudpilot_current_replicas", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Predicted requests / second", "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "cloudpilot_predicted_rps", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Forecast confidence", "id": 3,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [{ "expr": "cloudpilot_forecast_confidence", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Active anomalies", "id": 4,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "cloudpilot_active_anomalies", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Observed workload", "id": 5,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "expr": "cloudpilot_observed_request_rate", "legendFormat": "observed rps", "refId": "A" },
        { "expr": "cloudpilot_predicted_rps", "legendFormat": "predicted rps", "refId": "B" }
      ]
    },
    {
      "type": "timeseries", "title": "p95 latency and error rate", "id": 6,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "targets": [
        { "expr": "cloudpilot_observed_p95_latency_ms", "legendFormat": "p95 latency ms", "refId": "A" },
        { "expr": "cloudpilot_observed_error_rate * 100", "legendFormat": "error %", "refId": "B" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["cloudpilot", "kubernetes"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "title": "CloudPilot Overview",
  "uid": "cloudpilot-overview",
  "version": 1
}

